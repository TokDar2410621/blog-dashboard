{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": false,
    "outDir": "./dist/",
    "rootDir": "./",
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["credentials/**/*", "nodes/**/*"]
}

{
  "name": "n8n-nodes-gridar",
  "version": "0.1.0",
  "description": "n8n community node for Gridar - generate, audit and publish SEO articles from any n8n workflow.",
  "license": "MIT",
  "homepage": "https://github.com/TokDar2410621/blog-dashboard",
  "author": {
    "name": "Blog Dashboard"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokDar2410621/blog-dashboard.git",
    "directory": "n8n-node"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "gridar",
    "seo",
    "ai",
    "content"
  ],
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GridarApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Gridar/Gridar.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}

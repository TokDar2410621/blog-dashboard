# Backend API URL (the SPA points all requests at this base)
VITE_API_URL=http://localhost:8888/api

# OAuth client IDs — public values, safe to ship to the browser.
# Get them from https://console.cloud.google.com (Google) and
# https://github.com/settings/developers (GitHub OAuth Apps).
# Leave empty to hide the corresponding "Continue with X" button.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GITHUB_OAUTH_CLIENT_ID=

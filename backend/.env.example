# REQUIRED - Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated, no scheme).
# Local dev:
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (Railway): add your Railway URL + the future gridar.app domains
# ALLOWED_HOSTS=blog-dashboard-production-6480.up.railway.app,api.gridar.app,gridar.app

# Allowed CORS origins (comma-separated, WITH scheme).
# Local dev:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Production: CORS_ALLOWED_ORIGINS=https://gridar.app,https://www.gridar.app,https://blog-dashboard-ebon.vercel.app

# Auth cookie domain. Leave empty for host-only (default, correct for localhost).
# In production set to .gridar.app (with the leading dot) so the access_token /
# refresh_token cookies are shared between the marketing site (gridar.app),
# the dashboard SPA (gridar.app or app.gridar.app), and the API (api.gridar.app).
# AUTH_COOKIE_DOMAIN=.gridar.app

# CSRF trusted origins (comma-separated, WITH scheme).
# Required by Django 4+ for any cross-origin POST (admin login, OAuth
# callbacks behind a proxy, etc.). Wildcard subdomains supported.
# Local dev:
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8888
# Production (Railway):
# CSRF_TRUSTED_ORIGINS=https://gridar.app,https://www.gridar.app,https://api.gridar.app,https://blog-dashboard-ebon.vercel.app,https://*.up.railway.app

# Database URL (leave empty for default SQLite)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Pexels API key - https://www.pexels.com/api/
PEXELS_API_KEY=

# Google Gemini API key - https://aistudio.google.com/
GEMINI_API_KEY=

# Serper API key (for AI article search) - https://serper.dev/
SERPER_API_KEY=
